body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #ffffff;
    background-color: #121212;
    margin: 0;
    padding: 0;
}

header {
    background-color: #1f1f1f;
    padding: 1rem;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-right: 1rem;
}

nav ul li a {
    color: #ffffff;
    text-decoration: none;
}

main {
    padding: 2rem;
}

h1, h2 {
    color: #e0e0e0;
}

footer {
    background-color: #1f1f1f;
    color: #ffffff;
    text-align: center;
    padding: 1rem;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
}

.gallery img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 5px;
}

.pricing-packages {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

.package {
    background-color: #1f1f1f;
    border-radius: 5px;
    padding: 1rem;
    margin-bottom: 1rem;
    width: calc(33% - 1rem);
}

form {
    display: flex;
    flex-direction: column;
}

form label {
    margin-top: 1rem;
}

form input, form textarea {
    padding: 0.5rem;
    margin-top: 0.5rem;
    background-color: #2f2f2f;
    border: 1px solid #3f3f3f;
    color: #ffffff;
}

form button {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: #3f3f3f;
    color: #ffffff;
    border: none;
    cursor: pointer;
}

form button:hover {
    background-color: #4f4f4f;
}

@media screen and (max-width: 768px) {
    nav ul li {
        display: block;
        margin-bottom: 0.5rem;
    }

    .pricing-packages {
        flex-direction: column;
    }

    .package {
        width: 100%;
    }
}
